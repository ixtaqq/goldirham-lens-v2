# Copy to .env for local development. Never commit the filled-in file.
# In production these live in GitHub Actions secrets and Vercel environment variables;
# the comment on each line says where. See docs/RUNBOOK.md for first-time setup.

# GitHub secret: daily, backfill, backup, alerts. Locally: the Compose database.
DATABASE_URL_DIRECT=postgresql+asyncpg://lens:lens-local-only@127.0.0.1:55432/lens
# Vercel env: the pooled (transaction-mode) connection string for the webhook.
DATABASE_URL_POOLED=
# GitHub environment "production" only: migrations run with the migrator role.
DATABASE_URL_MIGRATOR=

# GitHub secret and Vercel env.
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=
# Vercel env: random string, also passed to `lens webhook set`.
TELEGRAM_WEBHOOK_SECRET=
# Vercel env: fine-grained token for this repository with Actions write, for /run and /watchlist add.
GITHUB_DISPATCH_TOKEN=
GITHUB_REPOSITORY=

# GitHub secrets: Healthchecks.io ping URLs (daily briefing, backup, restore drill).
HEALTHCHECK_PING_URL=
HEALTHCHECK_BACKUP_URL=
HEALTHCHECK_DRILL_URL=

# GitHub secret: free key from alphavantage.co, the US cross-check.
ALPHA_VANTAGE_API_KEY=
# GitHub secret: only when narrative.enabled is true in settings.yaml.
ANTHROPIC_API_KEY=

# GitHub secrets: age public key for backups; the private key is only in the restore-drill job.
AGE_RECIPIENT=
AGE_IDENTITY=

# Tests: a lens_test* database on the Compose server.
TEST_DATABASE_URL=postgresql+asyncpg://lens:lens-local-only@127.0.0.1:55432/lens_test
